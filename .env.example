# Copie para .env e preencha. O .env NUNCA é commitado.
# Todas são públicas por design (prefixo EXPO_PUBLIC_ entra no bundle do app).
# A chave service_role do Supabase NUNCA entra aqui.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud Console → Credentials → OAuth client do tipo "Web application"
# (sim, o client Web — é ele que gera o idToken aceito pelo Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
